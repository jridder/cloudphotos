// The Windows executable's icon and version details (build.rs passes the
// version from Cargo.toml as VERSION_* macros).
#include <winver.h>

1 ICON "cloudphotos.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Jeff Ridder"
            VALUE "FileDescription", "Cloud Photos"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "cloudphotos"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "cloudphotos.exe"
            VALUE "ProductName", "Cloud Photos"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
